[Unit]
Description=Haven Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/z/haven
ExecStart=/mnt/z/haven/.venv/bin/python3 /mnt/z/haven/haven_discord.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

# 安全限制
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
