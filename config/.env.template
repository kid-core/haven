# Haven 環境變數範本
# 複製到 $HAVEN_ROOT/config/.env 並填入你的實際值
#
# 命名規則：HAVEN_XXX 前綴為 Haven 專用，第三方慣例保留原名
# 所有值為 *** 表示必須填入

# ── 根目錄（可選，預設 /opt/haven） ──
# HAVEN_ROOT=/opt/haven

# ── 郵件服務 ──
SENDER_EMAIL=***
EMAIL_APP_PASSWORD=***

# ── 核心 AI 模型 ──
DEEPSEEK_API_KEY=***
OPENROUTER_API_KEY=***

# ── 模型選擇 ──
HAVEN_PRIMARY_MODEL=deepseek-v4-flash
HAVEN_FALLBACK_MODEL=google/gemma-4-26b-a4b-it

# ── Discord Bot Token ──
HAVEN_DISCORD_TOKEN=***

# ── Telegram Bot Token ──
HAVEN_TELEGRAM_TOKEN=***

# ── Ollama 本地模型 (可選，無 GPU 可跳過) ──
OLLAMA_BASE_URL=http://localhost:11434

# ── 搜尋引擎 ──
TAVILY_API_KEY=***

# ── Google / Gemini API (可選) ──
GOOGLE_API_KEY=***

# ── YouTube API (可選) ──
YOUTUBE_API_KEY=***

# ── Heartbeat Monitor ──
HAVEN_HEARTBEAT_URL=http://localhost:18789/
HAVEN_HEARTBEAT_INTERVAL=30
HAVEN_HEARTBEAT_THRESHOLD=3
HAVEN_HEARTBEAT_DISCORD_CHANNEL=0
HAVEN_HEARTBEAT_TELEGRAM_CHAT=0
